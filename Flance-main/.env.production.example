# ============================================================
# Modelo de variáveis de PRODUÇÃO (pagamentos). Copie para o painel do seu servidor.
# Valide antes de subir:  cd apps/api && npm run payments:check
# NUNCA commite valores reais.
# ============================================================
NODE_ENV=production

# --- Asaas (PRODUÇÃO) ---
# Chave $aact_prod_... entre ASPAS SIMPLES (o "$" é lido como variável sem elas)
ASAAS_API_KEY='$aact_prod_COLE_A_CHAVE_AQUI'
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=            # openssl rand -hex 32  (o MESMO valor no painel do Asaas)
ASAAS_CPF_ENCRYPTION_KEY=       # openssl rand -hex 32  (NÃO perca/troque: o CPF salvo fica ilegível)

# --- Contrato de assinatura (obrigatório em produção) ---
COMPANY_LEGAL_NAME=
COMPANY_CNPJ=
COMPANY_ADDRESS=
COMPANY_SUPPORT_EMAIL=
# E-mail do Encarregado de dados (DPO, LGPD art. 41). Se vazio, usa o de suporte.
COMPANY_PRIVACY_EMAIL=

# --- URLs reais (HTTPS). Os links dos e-mails de cobrança usam WEB_BASE_URL ---
WEB_BASE_URL=https://www.seudominio.com
CORS_ORIGIN=https://www.seudominio.com
NEXT_PUBLIC_API_URL=https://api.seudominio.com

# --- Atrás de proxy/load balancer (Nginx, Render, Railway...): 1 ---
TRUST_PROXY_HOPS=1

# --- Banco ---
# Aplicação: pooler (porta 6543). Migrations: conexão DIRETA (porta 5432).
DATABASE_URL=
DIRECT_URL=

# --- E-mail (código de ativação e avisos de cobrança) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Endereco autorizado da Flance que aparecera como remetente dos e-mails
SMTP_FROM=

JWT_SECRET=                     # openssl rand -base64 32
