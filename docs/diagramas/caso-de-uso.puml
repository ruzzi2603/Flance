@startuml caso-checkout
title Flance — Contratação de plano por Pix
left to right direction
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 45
skinparam actorStyle stickman
skinparam actorBorderColor #334155
skinparam actorFontColor #1F2937
skinparam usecaseBackgroundColor #7CC5E8
skinparam usecaseBorderColor #246A89
skinparam usecaseFontColor #123043
skinparam rectangleBackgroundColor #E6F5FC
skinparam rectangleBorderColor #246A89
skinparam ArrowColor #526B7A

actor "Pessoa usuária\nautenticada" as User
actor "Asaas" as Asaas

rectangle "Flance" {
  usecase "Contratar e ativar\nplano pago por Pix" as Subscribe
}

User --> Subscribe
Asaas --> Subscribe
note right of Subscribe
  O fluxo inclui aceite do contrato,
  cobrança inicial, confirmação do pagamento
  e código de ativação enviado por e-mail.
  Só depois o sistema ativa a mensalidade.
end note
@enduml

