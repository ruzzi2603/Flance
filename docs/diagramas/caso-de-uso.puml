@startuml caso-acesso
title Flance — Cadastro, acesso e recuperação de conta
left to right direction
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 45
skinparam actorStyle stickman
skinparam actorBorderColor #334155
skinparam actorFontColor #1F2937
skinparam usecaseBackgroundColor #7CC5E8
skinparam usecaseBorderColor #246A89
skinparam usecaseFontColor #123043
skinparam rectangleBackgroundColor #E6F5FC
skinparam rectangleBorderColor #246A89
skinparam ArrowColor #526B7A

actor "Visitante" as Visitor
actor "Serviço de e-mail\n(SMTP)" as Email

rectangle "Flance" {
  usecase "Criar conta" as Register
  usecase "Confirmar endereço\nde e-mail" as VerifyEmail
  usecase "Reenviar código\nde confirmação" as ResendEmail
  usecase "Entrar, renovar sessão\ne sair" as Session
  usecase "Recuperar e redefinir\nsenha" as ResetPassword
}

Visitor --> Register
Visitor --> VerifyEmail
Visitor --> ResendEmail
Visitor --> Session
Visitor --> ResetPassword
Email --> VerifyEmail
Email --> ResendEmail
Email --> ResetPassword
Register ..> VerifyEmail : <<include>>
@enduml

