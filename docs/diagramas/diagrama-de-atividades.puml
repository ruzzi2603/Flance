@startuml fluxo-cadastro
title Flance — Cadastro e confirmação de e-mail
skinparam shadowing false
skinparam linetype ortho
skinparam activityBackgroundColor #D8F1FC
skinparam activityBorderColor #246A89
skinparam activityDiamondBackgroundColor #69C5E8
skinparam activityDiamondBorderColor #246A89
skinparam activityStartColor #183B56
skinparam activityEndColor #183B56
skinparam ArrowColor #405B70

|Visitante|
start
:Preencher dados da conta;
|Interface web|
:Enviar cadastro à API;
|API|
:Validar dados e solicitar\nconfirmação de e-mail;
|Banco de dados|
:Guardar código de confirmação\n(EmailVerificationCode);
|Serviço de e-mail|
:Enviar código ao endereço informado;
|Pessoa usuária|
:Informar o código recebido;
|API|
:Conferir código, validade\ne número de tentativas;
if (Código válido?) then (sim)
  :Criar conta e credenciais de sessão;
  |Banco de dados|
  :Guardar usuário (User)\ne sessão (RefreshToken);
  |Interface web|
  :Abrir a conta autenticada;
  stop
else (não)
  |Interface web|
  :Mostrar erro e oferecer\nnova tentativa ou reenvio;
  stop
endif
@enduml

@startuml fluxo-vagas-propostas
title Flance — Publicação de vaga e negociação de proposta
skinparam shadowing false
skinparam linetype ortho
skinparam activityBackgroundColor #D8F1FC
skinparam activityBorderColor #246A89
skinparam activityDiamondBackgroundColor #69C5E8
skinparam activityDiamondBorderColor #246A89
skinparam activityStartColor #183B56
skinparam activityEndColor #183B56
skinparam ArrowColor #405B70

|Cliente ou profissional freelancer|
start
:Preencher e enviar uma vaga;
|Interface web|
:Enviar solicitação para criar vaga;
|API|
:Validar sessão, perfil e dados;
if (Perfil CLIENT ou FREELANCER?) then (sim)
  |Banco de dados|
  :Guardar vaga (Job);
else (não)
  |Interface web|
  :Mostrar acesso negado;
  stop
endif

|Profissional freelancer|
:Consultar vaga e enviar proposta;
|API|
:Validar vaga, autoria e ausência\nde proposta duplicada;
if (Proposta permitida?) then (sim)
  |Banco de dados|
  :Guardar proposta (Proposal);
  :Criar conversa e mensagem inicial\n(Conversation e Message);
  |API|
  :Notificar cliente;
  |Cliente|
  :Consultar proposta e decidir;
  |API|
  if (Decisão do cliente?) then (aceitar)
    |Banco de dados|
    :Atualizar proposta para aceita\n(ACCEPTED);
    :Atualizar vaga para em andamento\n(IN_PROGRESS);
  else (rejeitar)
    |Banco de dados|
    :Atualizar proposta para rejeitada\n(REJECTED);
  endif
  |Cliente|
  if (Cancelar acordo aceito?) then (sim)
    :Informar motivo do cancelamento;
    |API|
    :Validar propriedade e situação da proposta;
    |Banco de dados|
    :Registrar cancelamento;\nReabrir vaga (OPEN);
  else (não)
    :Continuar negociação na conversa;
  endif
  stop
else (não)
  |Interface web|
  :Mostrar erro de validação,\nduplicidade ou autorização;
  stop
endif
@enduml

@startuml fluxo-pagamento-mensal
title Flance — Contratação e cobrança mensal por Pix
skinparam shadowing false
skinparam linetype ortho
skinparam activityBackgroundColor #D8F1FC
skinparam activityBorderColor #246A89
skinparam activityDiamondBackgroundColor #69C5E8
skinparam activityDiamondBorderColor #246A89
skinparam activityStartColor #183B56
skinparam activityEndColor #183B56
skinparam ArrowColor #405B70

|Pessoa usuária autenticada|
start
:Consultar plano e preço;
:Ler e aceitar contrato vigente;
:Enviar dados do pagador;
|Interface web|
:Solicitar cobrança inicial\ncom chave de idempotência;
|API|
:Validar contrato, plano, e-mail\ne dados do pagador;
if (Dados válidos?) then (sim)
  |Banco de dados|
  :Registrar cobrança inicial pendente\n(Payment INITIAL);
  :Guardar aceite e cópia do contrato\n(ContractAcceptance);
  |API|
  :Localizar ou criar cliente Asaas;
  :Solicitar cobrança inicial por Pix;
  |Asaas|
  :Criar cobrança e devolver identificador;
  |API|
  :Guardar identificador e dados do Pix;
  |Interface web|
  :Exibir Pix e situação da cobrança;
  |Pessoa usuária autenticada|
  :Pagar Pix no aplicativo bancário;
  |Asaas|
  :Confirmar pagamento e enviar aviso;
  |API|
  :Validar aviso e consultar cobrança\nno Asaas;
  if (Pagamento confirmado?) then (sim)
    |Banco de dados|
    :Marcar cobrança como paga (PAID);\nCriar código de ativação;
    |Serviço de e-mail|
    :Enviar código de ativação;
    |Pessoa usuária autenticada|
    :Informar código recebido;
    |API|
    :Validar código, validade\ne número de tentativas;
    if (Código válido?) then (sim)
      |Banco de dados|
      :Ativar assinatura (Subscription)\ne plano da conta;
      |API|
      :Programar assinatura mensal no Asaas;
      |Asaas|
      :Gerar e liquidar cobranças mensais;
      :Enviar avisos de pagamento;
      |API|
      :Validar valor, cliente e assinatura;
      |Banco de dados|
      :Registrar mensalidade paga e estender\nperíodo de acesso;
      stop
    else (não)
      |Interface web|
      :Mostrar erro e oferecer reenvio\nsujeito aos limites;
      stop
    endif
  else (não)
    |Interface web|
    :Manter a cobrança pendente\nou mostrar a situação recebida;
    stop
  endif
else (não)
  |Interface web|
  :Mostrar erro de validação\nou de aceite do contrato;
  stop
endif
@enduml

@startuml fluxo-renovacao
title Flance — Renovação, cancelamento e vencimento
skinparam shadowing false
skinparam linetype ortho
skinparam activityBackgroundColor #D8F1FC
skinparam activityBorderColor #246A89
skinparam activityDiamondBackgroundColor #69C5E8
skinparam activityDiamondBorderColor #246A89
skinparam activityStartColor #183B56
skinparam activityEndColor #183B56
skinparam ArrowColor #405B70

|Pessoa usuária autenticada|
start
:Consultar minha assinatura;
if (Renovação automática ativa?) then (sim)
  :Solicitar cancelamento;
  |API|
  :Solicitar cancelamento ao Asaas;
  if (Asaas confirmou?) then (sim)
    |Banco de dados|
    :Marcar cancelamento ao fim do período;\nCancelar cobranças em aberto;
    :Manter acesso até o fim do período pago;
  else (não)
    |Interface web|
    :Informar falha sem registrar\ncancelamento;
    stop
  endif
else (não)
  :Solicitar reativação antes\ndo fim do período;
  |API|
  :Reativar assinatura e programar\ncobrança recorrente;
endif

|Rotina periódica da API|
:A cada seis horas, sincronizar cobranças,\nenviar lembretes e verificar vencimentos;
if (Período pago terminou?) then (sim)
  |API|
  :Cancelar assinatura e cobranças em aberto;
  |Banco de dados|
  :Marcar assinatura como expirada (EXPIRED);\nRetornar conta ao plano gratuito (FREE);
else (não)
  :Manter plano até o fim do período pago;
endif
stop
@enduml
