erDiagram
    %% Unique composites: CompanyReview(companyId, authorId); CompanyAnalyticsEvent(companyId, sessionId, eventType, source).
    %% Unique composites: Proposal(freelancerId, jobId); Conversation(jobId, freelancerId); Badge(userId, name).
    User {
        TEXT id PK
        TEXT email UK
        TEXT password
        TEXT name
        Role role
        TIMESTAMP bannedAt "nullable"
        TEXT banReason "nullable"
        TIMESTAMP emailVerifiedAt "nullable"
        TEXT bio "nullable"
        TEXT avatarUrl "nullable"
        TEXT headline "nullable"
        TEXT services "nullable"
        TEXT_ARRAY servicesTags
        TEXT needs "nullable"
        BOOLEAN companyEnabled
        TEXT companyName "nullable"
        TEXT companyCnpj "nullable"
        TEXT companyDescription "nullable"
        TEXT companyLocation "nullable"
        TEXT companyCity "nullable"
        TEXT companyState "nullable"
        TEXT companyAddress "nullable"
        TEXT companyWebsite "nullable"
        TEXT companyInstagram "nullable"
        TEXT companyWhatsapp "nullable"
        TEXT companyEmail "nullable"
        TEXT companyHours "nullable"
        TEXT_ARRAY companyPhotos
        BOOLEAN companyIsOnline
        BOOLEAN companyIsPhysical
        INTEGER companyViews
        PlanTier planTier
        TIMESTAMP planStartedAt "nullable"
        TIMESTAMP planRenewsAt "nullable"
        TEXT asaasCustomerId UK "nullable"
        TEXT cpf "nullable"
        TEXT cpfEncrypted "nullable"
        INTEGER xp
        INTEGER level
        TIMESTAMP createdAt
        TIMESTAMP updatedAt
    }
    EmailVerificationCode {
        TEXT id PK
        TEXT email UK
        TEXT name
        TEXT passwordHash
        TEXT avatarUrl "nullable"
        TEXT codeHash
        INTEGER attempts
        TIMESTAMP expiresAt
        TIMESTAMP lastSentAt
        TIMESTAMP createdAt
        TIMESTAMP updatedAt
    }
    AdminAuditLog {
        TEXT id PK
        TEXT adminId
        TEXT targetUserId "nullable"
        TEXT targetEmail
        TEXT targetName
        AdminActionType action
        TEXT reason
        AdminNotificationStatus notificationStatus
        TIMESTAMP createdAt
    }
    CompanyReview {
        TEXT id PK
        INTEGER rating
        TEXT comment "nullable"
        TEXT companyId FK
        TEXT authorId FK
        TIMESTAMP createdAt
        TIMESTAMP updatedAt
    }
    CompanyAnalyticsEvent {
        TEXT id PK
        TEXT companyId FK
        CompanyAnalyticsEventType eventType
        TEXT sessionId
        TEXT source
        INTEGER durationSeconds
        TIMESTAMP createdAt
    }
    Job {
        TEXT id PK
        TEXT title
        TEXT description
        BudgetType budgetType
        DECIMAL_10_2 budget "nullable"
        DECIMAL_10_2 budgetMin "nullable"
        DECIMAL_10_2 budgetMax "nullable"
        JobStatus status
        TEXT clientId FK
        TEXT category
        TIMESTAMP createdAt
        TIMESTAMP updatedAt
    }
    Proposal {
        TEXT id PK
        TEXT text
        DECIMAL_10_2 bidAmount
        TEXT freelancerId FK
        TEXT jobId FK
        DOUBLE aiScore
        ProposalStatus status
        TIMESTAMP respondedAt "nullable"
        TIMESTAMP createdAt
        TIMESTAMP updatedAt
    }
    Conversation {
        TEXT id PK
        TEXT jobId FK "nullable"
        TEXT clientId FK
        TEXT freelancerId FK
        TEXT proposalId FK "unique, nullable"
        TIMESTAMP createdAt
        TIMESTAMP updatedAt
    }
    Message {
        TEXT id PK
        TEXT conversationId FK
        TEXT senderId FK
        TEXT body
        TIMESTAMP createdAt
    }
    EscrowTransaction {
        TEXT id PK
        DECIMAL_10_2 amount
        EscrowStatus status
        TEXT jobId FK
        TIMESTAMP createdAt
        TIMESTAMP updatedAt
    }
    Badge {
        TEXT id PK
        TEXT name
        TEXT icon
        TEXT userId FK
        TIMESTAMP createdAt
    }
    RefreshToken {
        TEXT id PK
        TEXT tokenHash UK
        TEXT userId FK
        TIMESTAMP expiresAt
        TIMESTAMP revokedAt "nullable"
        TIMESTAMP createdAt
        TIMESTAMP updatedAt
    }
    PasswordReset {
        TEXT id PK
        TEXT userId FK
        TEXT tokenHash UK
        TEXT code
        INTEGER attempts
        TIMESTAMP expiresAt
        TIMESTAMP usedAt "nullable"
        TIMESTAMP createdAt
    }
    Subscription {
        TEXT id PK
        TEXT userId FK
        PlanTier plan
        SubscriptionStatus status
        TIMESTAMP startedAt "nullable"
        TIMESTAMP expiresAt "nullable"
        TIMESTAMP renewalReminderSentAt "nullable"
        TEXT asaasSubscriptionId UK "nullable"
        INTEGER billingAnchorDay
        TIMESTAMP nextDueDate "nullable"
        DECIMAL_10_2 recurringAmount "nullable"
        BOOLEAN cancelAtPeriodEnd
        TIMESTAMP canceledAt "nullable"
        TIMESTAMP billingSyncLockedAt "nullable"
        TIMESTAMP createdAt
        TIMESTAMP updatedAt
    }
    Payment {
        TEXT id PK
        TEXT userId FK
        TEXT subscriptionId FK "nullable"
        PlanTier plan
        DECIMAL_10_2 amount
        PaymentProvider provider
        TEXT providerPaymentId UK "nullable"
        TEXT requestKey UK "nullable"
        PaymentKind kind
        TEXT providerSubscriptionId "nullable"
        TIMESTAMP coversUntil "nullable"
        TIMESTAMP reminderSentAt "nullable"
        TIMESTAMP overdueNoticeSentAt "nullable"
        PaymentStatus status
        TIMESTAMP dueDate "nullable"
        TIMESTAMP paidAt "nullable"
        TEXT pixQrCode "nullable"
        TEXT pixCopyPaste "nullable"
        TIMESTAMP pixExpiresAt "nullable"
        TIMESTAMP createdAt
        TIMESTAMP updatedAt
    }
    PaymentActivationCode {
        TEXT id PK
        TEXT userId FK
        TEXT paymentId FK "unique"
        PlanTier plan
        TEXT codeHash
        INTEGER attempts
        INTEGER resendCount
        TIMESTAMP lastSentAt "nullable"
        TIMESTAMP emailSentAt "nullable"
        TIMESTAMP expiresAt
        TIMESTAMP usedAt "nullable"
        TIMESTAMP createdAt
        TIMESTAMP updatedAt
    }
    PaymentWebhookEvent {
        TEXT id PK
        TEXT eventId UK
        TEXT eventType
        TEXT providerPaymentId "nullable"
        WebhookEventStatus status
        JSONB payload "nullable"
        TEXT errorMessage "nullable"
        TIMESTAMP receivedAt
        TIMESTAMP processedAt "nullable"
    }
    ContractAcceptance {
        TEXT id PK
        TEXT userId FK
        TEXT contractKey
        TEXT contractVersion
        TEXT contractHash
        JSONB contractSnapshot
        PlanTier plan
        DECIMAL_10_2 planPrice
        INTEGER billingAnchorDay
        DECIMAL_10_2 initialAmount
        TEXT paymentId UK "nullable"
        TEXT ipAddress "nullable"
        TEXT userAgent "nullable"
        TIMESTAMP acceptedAt
    }

    User ||--o{ Job : "clientId"
    User ||--o{ Proposal : "freelancerId"
    Job ||--o{ Proposal : "jobId"
    User ||--o{ CompanyReview : "companyId"
    User ||--o{ CompanyReview : "authorId"
    User ||--o{ CompanyAnalyticsEvent : "companyId"
    User ||--o{ Conversation : "clientId"
    User ||--o{ Conversation : "freelancerId"
    Job o|--o{ Conversation : "jobId opcional"
    Proposal o|--o| Conversation : "proposalId único e opcional"
    Conversation ||--o{ Message : "conversationId"
    User ||--o{ Message : "senderId"
    Job ||--o{ EscrowTransaction : "jobId"
    User ||--o{ Badge : "userId"
    User ||--o{ RefreshToken : "userId"
    User ||--o{ PasswordReset : "userId"
    User ||--o{ Subscription : "userId"
    User ||--o{ Payment : "userId"
    Subscription o|--o{ Payment : "subscriptionId opcional"
    User ||--o{ PaymentActivationCode : "userId"
    Payment ||--o| PaymentActivationCode : "paymentId único"
    User ||--o{ ContractAcceptance : "userId"
