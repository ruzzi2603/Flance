@startuml classes-assinaturas-dados
title Flance — Classes: assinatura e dados de pagamento
top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #EAF7FC
skinparam classHeaderBackgroundColor #79C9E9
skinparam classBorderColor #246A89
skinparam ArrowColor #526B7A
hide empty members

package "Modelos Prisma" {
  class "Usuário (User)" as User <<modelo>> {
    id: String
    plano / planTier: PlanTier
    cliente Asaas / asaasCustomerId: String?
  }
  class "Assinatura (Subscription)" as Subscription <<modelo>> {
    id: String
    usuário / userId: String
    plano / plan: PlanTier
    situação / status: SubscriptionStatus
    próxima cobrança / nextDueDate: DateTime?
    cancelar ao fim do período / cancelAtPeriodEnd: Boolean
  }
  class "Pagamento (Payment)" as Payment <<modelo>> {
    id: String
    usuário / userId: String
    assinatura / subscriptionId: String?
    valor / amount: Decimal
    tipo / kind: PaymentKind
    situação / status: PaymentStatus
  }
  class "Código de ativação\n(PaymentActivationCode)" as PaymentActivationCode <<modelo>> {
    id: String
    usuário / userId: String
    pagamento / paymentId: String
    validade / expiresAt: DateTime
  }
  class "Aviso de pagamento\n(PaymentWebhookEvent)" as PaymentWebhookEvent <<modelo>> {
    id: String
    identificador / eventId: String
    situação / status: WebhookEventStatus
  }
  class "Aceite do contrato\n(ContractAcceptance)" as ContractAcceptance <<modelo>> {
    id: String
    usuário / userId: String
    versão / contractVersion: String
    pagamento / paymentId: String?
    aceitoEm / acceptedAt: DateTime
  }
}

User "1" -- "0..*" Subscription : possui
User "1" -- "0..*" Payment : realiza
Subscription "0..1" -- "0..*" Payment : pode gerar
Payment "1" -- "0..1" PaymentActivationCode : pode receber
User "1" -- "0..*" PaymentActivationCode : recebe
User "1" -- "0..*" ContractAcceptance : registra
note right of PaymentWebhookEvent
  providerPaymentId não possui relação
  declarada no schema Prisma.
end note
note right of ContractAcceptance
  paymentId é uma coluna opcional e única,
  sem relação/FK declarada com Payment.
end note
@enduml

@startuml classes-pagamentos-api
