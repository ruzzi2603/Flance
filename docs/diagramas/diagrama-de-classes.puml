    moderateAd()
    banUser()
    alertUser()
    unbanUser()
    deleteUser()
  }
  class "Controlador de privacidade\n(PrivacyController)" as PrivacyController <<controlador>> {
    exportData()
    deleteAccount()
  }
}

package "Serviços" {
  class "Serviço administrativo\n(AdminService)" as AdminService <<serviço>> {
    listUsers()
    listAds()
    listAuditLogs()
