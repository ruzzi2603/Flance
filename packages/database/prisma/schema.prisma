// FLANCE DATABASE SCHEMA
// Propósito: Definir estrutura de dados para todo o sistema
// Ferramentas: Prisma ORM + PostgreSQL 15+
//
// Pagamentos:
// - Asaas
// - PIX
// - Assinaturas de 30 dias
// - Webhook para confirmação
// - Código de ativação enviado por e-mail

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ============================================================
// ENUMS
// ============================================================

enum Role {
  CLIENT
  FREELANCER
  ADMIN
}

enum AdminActionType {
  USER_ALERTED
  AD_REMOVED
  AD_RESTORED
  USER_BANNED
  USER_UNBANNED
  USER_DELETED
}

enum AdminNotificationStatus {
  PENDING
  SENT
  FAILED
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum BudgetType {
  FIXED
  RANGE
  NEGOTIABLE
}

enum EscrowStatus {
  PENDING
  RELEASED
  REFUNDED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}


// ============================================================
// PLANOS
// ============================================================
//
// FREE              = gratuito
// PROFESSIONAL      = R$ 29,99 / 30 dias
// PROFESSIONAL_PLUS = R$ 39,99 / 30 dias
//
// BASIC, PRO e PREMIUM permanecem temporariamente para evitar
// problemas caso existam registros antigos no banco.
// Eles podem ser removidos posteriormente através de migration
// depois que verificarmos se não estão sendo utilizados.
// ============================================================

enum PlanTier {
  FREE
  BASIC
  PRO
  PREMIUM
  PROFESSIONAL
  PROFESSIONAL_PLUS
}


// ============================================================
// PAGAMENTOS
// ============================================================

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  EXPIRED
  REFUNDED
}

enum PaymentProvider {
  ASAAS
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELED
}


// ============================================================
// WEBHOOK
// ============================================================

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}


// ============================================================
// ANALYTICS
// ============================================================

enum CompanyAnalyticsEventType {
  VIEW
  SHARE
}


// ============================================================
// USER
// ============================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role

  bannedAt  DateTime?
  banReason String?

  emailVerifiedAt DateTime?

  bio       String?
  avatarUrl String?
  headline  String?
  services  String?
  servicesTags String[] @default([])
  needs     String?


  // ==========================================================
  // DADOS DE EMPRESA
  // ==========================================================

  companyEnabled Boolean @default(false)

  companyName        String?
  companyCnpj        String?
  companyDescription String?

  companyLocation String?
  companyCity     String?
  companyState    String?
  companyAddress  String?

  companyWebsite   String?
  companyInstagram String?
  companyWhatsapp  String?
  companyEmail     String?
  companyHours     String?

  companyPhotos String[] @default([])

  companyIsOnline   Boolean @default(true)
  companyIsPhysical Boolean @default(false)

  companyViews Int @default(0)


  // ==========================================================
  // PLANO / ASSINATURA
  // ==========================================================

  planTier PlanTier @default(FREE)

  planStartedAt DateTime?
  planRenewsAt  DateTime?


  // ==========================================================
  // ASAAS
  // ==========================================================
  //
  // asaasCustomerId:
  // ID do cliente correspondente dentro do Asaas.
  //
  // cpf:
  // CPF utilizado para identificação/cobrança.
  //
  // A API Key do Asaas NÃO fica no banco.
  // Ela fica exclusivamente no .env do backend.
  // ==========================================================

  asaasCustomerId String? @unique

  // CPF de cobrança em texto legado; novas gravações usam apenas cpfEncrypted.
  cpf String?
  cpfEncrypted String?


  // ==========================================================
  // GAMIFICAÇÃO
  // ==========================================================

  xp    Int @default(0)
  level Int @default(1)


  // ==========================================================
  // AUDITORIA
  // ==========================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // ==========================================================
  // RELACIONAMENTOS
  // ==========================================================

  postedJobs Job[] @relation("ClientJobs")

  proposals Proposal[] @relation("FreelancerProposals")

  receivedCompanyReviews CompanyReview[] @relation("CompanyReviewsReceived")

  authoredCompanyReviews CompanyReview[] @relation("CompanyReviewsAuthored")

  analyticsEvents CompanyAnalyticsEvent[]

  badges Badge[]

  refreshTokens RefreshToken[]

  passwordResets PasswordReset[]

  conversationsAsClient Conversation[] @relation("ClientConversations")

  conversationsAsFreelancer Conversation[] @relation("FreelancerConversations")

  messages Message[]

  subscriptions Subscription[]

  payments Payment[]

  activationCodes PaymentActivationCode[]


  // ==========================================================
  // INDEXES
  // ==========================================================

  @@index([email])
  @@index([role])
  @@index([companyEnabled])
  @@index([createdAt])
}


// ============================================================
// EMAIL VERIFICATION
// ============================================================

model EmailVerificationCode {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String

  codeHash String

  attempts Int @default(0)

  expiresAt DateTime

  lastSentAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}


// ============================================================
// ADMIN AUDIT LOG
// ============================================================

model AdminAuditLog {
  id                 String                  @id @default(cuid())
  adminId            String
  targetUserId       String?
  targetEmail        String
  targetName         String
  action             AdminActionType
  reason             String
  notificationStatus AdminNotificationStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId, createdAt])
  @@index([adminId, createdAt])
}


// ============================================================
// COMPANY REVIEW
// ============================================================

model CompanyReview {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?

  companyId String
  authorId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company User @relation("CompanyReviewsReceived", fields: [companyId], references: [id], onDelete: Cascade)
  author User @relation("CompanyReviewsAuthored", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([companyId, authorId])

  @@index([companyId, createdAt])
  @@index([authorId])
}


// ============================================================
// COMPANY ANALYTICS
// ============================================================

model CompanyAnalyticsEvent {
  id              String                     @id @default(cuid())
  companyId       String
  eventType       CompanyAnalyticsEventType

  sessionId String

  source String @default("profile")

  durationSeconds Int @default(0)

  createdAt DateTime @default(now())

  company User @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, eventType, createdAt])
  @@index([companyId, createdAt])

  @@unique([companyId, sessionId, eventType, source])
}


// ============================================================
// JOB
// ============================================================

model Job {
  id          String     @id @default(cuid())
  title       String
  description String

  budgetType BudgetType @default(FIXED)

  budget    Decimal? @db.Decimal(10, 2)
  budgetMin Decimal? @db.Decimal(10, 2)
  budgetMax Decimal? @db.Decimal(10, 2)

  status JobStatus @default(OPEN)

  clientId String

  category String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // ==========================================================
  // RELACIONAMENTOS
  // ==========================================================

  client User @relation("ClientJobs", fields: [clientId], references: [id], onDelete: Cascade)

  proposals Proposal[]

  escrow EscrowTransaction[]

  conversations Conversation[]


  // ==========================================================
  // INDEXES
  // ==========================================================

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@index([category])
}


// ============================================================
// PROPOSAL
// ============================================================

model Proposal {
  id   String @id @default(cuid())
  text String

  bidAmount Decimal @db.Decimal(10, 2)

  freelancerId String
  jobId        String

  aiScore Float @default(0)

  status ProposalStatus @default(PENDING)

  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // ==========================================================
  // RELACIONAMENTOS
  // ==========================================================

  freelancer User @relation("FreelancerProposals", fields: [freelancerId], references: [id], onDelete: Cascade)
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  conversation Conversation?


  // ==========================================================
  // CONSTRAINTS
  // ==========================================================

  @@unique([freelancerId, jobId])


  // ==========================================================
  // INDEXES
  // ==========================================================

  @@index([jobId])
  @@index([freelancerId])
  @@index([status])
  @@index([createdAt])
  @@index([aiScore])
  @@index([freelancerId, jobId, status])
}


// ============================================================
// CONVERSATION
// ============================================================

model Conversation {
  id String @id @default(cuid())

  jobId String?

  clientId     String
  freelancerId String

  proposalId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // ==========================================================
  // RELACIONAMENTOS
  // ==========================================================

  job Job? @relation(fields: [jobId], references: [id], onDelete: Cascade)
  client User @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)
  freelancer User @relation("FreelancerConversations", fields: [freelancerId], references: [id], onDelete: Cascade)
  proposal Proposal? @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  messages Message[]


  // ==========================================================
  // CONSTRAINTS
  // ==========================================================

  @@unique([jobId, freelancerId])


  // ==========================================================
  // INDEXES
  // ==========================================================

  @@index([clientId])
  @@index([freelancerId])
  @@index([jobId])
  @@index([updatedAt])
}


// ============================================================
// MESSAGE
// ============================================================

model Message {
  id String @id @default(cuid())

  conversationId String
  senderId       String

  body String

  createdAt DateTime @default(now())


  // ==========================================================
  // RELACIONAMENTOS
  // ==========================================================

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)


  // ==========================================================
  // INDEXES
  // ==========================================================

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}


// ============================================================
// ESCROW
// ============================================================

model EscrowTransaction {
  id String @id @default(cuid())

  amount Decimal @db.Decimal(10, 2)

  status EscrowStatus @default(PENDING)

  jobId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)


  @@index([jobId])
  @@index([status])
}


// ============================================================
// BADGE
// ============================================================

model Badge {
  id String @id @default(cuid())

  name String
  icon String

  userId String

  createdAt DateTime @default(now())


  user User @relation(fields: [userId], references: [id], onDelete: Cascade)


  @@unique([userId, name])

  @@index([userId])
}


// ============================================================
// REFRESH TOKEN
// ============================================================

model RefreshToken {
  id String @id @default(cuid())

  tokenHash String @unique

  userId String

  expiresAt DateTime

  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  user User @relation(fields: [userId], references: [id], onDelete: Cascade)


  @@index([userId])
  @@index([expiresAt])
}


// ============================================================
// PASSWORD RESET
// ============================================================

model PasswordReset {
  id String @id @default(cuid())

  userId String

  tokenHash String @unique

  code String

  attempts Int @default(0)

  expiresAt DateTime

  usedAt DateTime?

  createdAt DateTime @default(now())


  user User @relation(fields: [userId], references: [id], onDelete: Cascade)


  @@index([userId])
  @@index([expiresAt])
}


// ============================================================
// SUBSCRIPTION
// ============================================================
//
// Uma assinatura representa o plano atualmente contratado
// pelo usuário.
//
// Exemplo:
//
// PROFESSIONAL
// startedAt = 01/10/2026
// expiresAt = 31/10/2026
//
// PROFESSIONAL_PLUS
// startedAt = 01/10/2026
// expiresAt = 31/10/2026
//
// A renovação é manual via PIX.
// ============================================================

model Subscription {
  id String @id @default(cuid())

  userId String

  plan PlanTier

  status SubscriptionStatus @default(PENDING)

  startedAt DateTime?

  expiresAt DateTime?

  renewalReminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // ==========================================================
  // RELACIONAMENTOS
  // ==========================================================

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  payments Payment[]


  // ==========================================================
  // INDEXES
  // ==========================================================

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}


// ============================================================
// PAYMENT
// ============================================================
//
// Cada tentativa de pagamento possui um registro próprio.
//
// Exemplo:
//
// PROFESSIONAL
// R$ 29,99
// ASAAS
// PIX
//
// ou
//
// PROFESSIONAL_PLUS
// R$ 39,99
// ASAAS
// PIX
// ============================================================

model Payment {
  id String @id @default(cuid())


  // ==========================================================
  // USUÁRIO
  // ==========================================================

  userId String


  // ==========================================================
  // ASSINATURA
  // ==========================================================

  subscriptionId String?


  // ==========================================================
  // PLANO
  // ==========================================================

  plan PlanTier


  // ==========================================================
  // VALOR
  // ==========================================================

  amount Decimal @db.Decimal(10, 2)


  // ==========================================================
  // PROVEDOR
  // ==========================================================

  provider PaymentProvider @default(ASAAS)


  // ==========================================================
  // ID DA COBRANÇA NO ASAAS
  // ==========================================================

  providerPaymentId String? @unique
  requestKey String? @unique


  // ==========================================================
  // STATUS
  // ==========================================================

  status PaymentStatus @default(PENDING)


  // ==========================================================
  // DATAS
  // ==========================================================

  dueDate DateTime?

  paidAt DateTime?


  // ==========================================================
  // PIX
  // ==========================================================
  //
  // pixQrCode:
  // imagem do QR Code retornada pelo Asaas.
  //
  // pixCopyPaste:
  // código Pix Copia e Cola.
  //
  // Esses dados pertencem à cobrança específica.
  // ==========================================================

  pixQrCode String? @db.Text

  pixCopyPaste String? @db.Text
  pixExpiresAt DateTime?


  // ==========================================================
  // AUDITORIA
  // ==========================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // ==========================================================
  // RELACIONAMENTOS
  // ==========================================================

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  activationCode PaymentActivationCode?


  // ==========================================================
  // INDEXES
  // ==========================================================

  @@index([userId])
  @@index([providerPaymentId])
  @@index([status])
  @@index([createdAt])
}


// ============================================================
// PAYMENT ACTIVATION CODE
// ============================================================
//
// Depois que o Asaas confirmar o pagamento:
//
// pagamento confirmado
//        ↓
// gera código
//        ↓
// envia por e-mail
//        ↓
// usuário informa código
//        ↓
// assinatura é ativada
//
// O código armazenado no banco é HASH.
// O código original nunca fica salvo.
// ============================================================

model PaymentActivationCode {
  id String @id @default(cuid())


  // ==========================================================
  // USUÁRIO
  // ==========================================================

  userId String


  // ==========================================================
  // PAGAMENTO
  // ==========================================================

  paymentId String @unique


  // ==========================================================
  // PLANO
  // ==========================================================

  plan PlanTier


  // ==========================================================
  // CÓDIGO
  // ==========================================================

  codeHash String

  attempts Int @default(0)
  resendCount Int @default(0)
  lastSentAt DateTime?
  emailSentAt DateTime?


  // ==========================================================
  // VALIDADE
  // ==========================================================

  expiresAt DateTime

  usedAt DateTime?


  // ==========================================================
  // AUDITORIA
  // ==========================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // ==========================================================
  // RELACIONAMENTOS
  // ==========================================================

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)


  // ==========================================================
  // INDEXES
  // ==========================================================

  @@index([userId])
  @@index([paymentId])
  @@index([expiresAt])
}


// ============================================================
// ASAAS WEBHOOK EVENT
// ============================================================
//
// Usado para garantir que o mesmo evento do Asaas não seja
// processado duas vezes.
//
// Exemplo:
//
// Asaas envia PAYMENT_RECEIVED
//        ↓
// Flance processa
//        ↓
// marca evento como PROCESSED
//
// Se o mesmo evento chegar novamente:
//        ↓
// Flance identifica o eventId
//        ↓
// não duplica a ativação.
// ============================================================

model PaymentWebhookEvent {
  id String @id @default(cuid())


  // ==========================================================
  // ID DO EVENTO
  // ==========================================================
  //
  // Deve ser único para impedir processamento duplicado.
  // ==========================================================

  eventId String @unique


  // ==========================================================
  // EVENTO ASAAS
  // ==========================================================

  eventType String


  // ==========================================================
  // PAGAMENTO ASAAS
  // ==========================================================

  providerPaymentId String?


  // ==========================================================
  // STATUS DO PROCESSAMENTO
  // ==========================================================

  status WebhookEventStatus @default(RECEIVED)


  // ==========================================================
  // PAYLOAD
  // ==========================================================
  //
  // Guarda o payload recebido para auditoria/debug.
  // Não deve conter dados sensíveis desnecessários.
  // ==========================================================

  payload Json?


  // ==========================================================
  // ERRO
  // ==========================================================

  errorMessage String?


  // ==========================================================
  // DATAS
  // ==========================================================

  receivedAt DateTime @default(now())

  processedAt DateTime?


  // ==========================================================
  // INDEXES
  // ==========================================================

  @@index([eventType])

  @@index([providerPaymentId])

  @@index([status])

  @@index([receivedAt])
}